{
  "openapi": "3.0.3",
  "info": {
    "title": "Api",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "description": "For all authentications requests",
      "name": "auth"
    }
  ],
  "paths": {
    "/auth/sign-up": {
      "post": {
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Credentials"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SignUpResult"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Create new account with basic user role",
        "tags": ["auth"]
      }
    },
    "/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Credentials"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SignInResult"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Login with and existing account",
        "tags": ["auth"]
      }
    },
    "/account/{accountId}/label": {
      "get": {
        "operationId": "getAll",
        "parameters": [
          {
            "explode": false,
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Label"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get all disponibles lables for the specified account",
        "tags": ["label"]
      },
      "post": {
        "operationId": "createOne",
        "parameters": [
          {
            "explode": false,
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CreationLabel"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Label"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Create new label for the specified account",
        "tags": ["label"]
      }
    },
    "/account/{accountId}/label/{labelId}": {
      "get": {
        "operationId": "getOne",
        "parameters": [
          {
            "explode": false,
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "explode": false,
            "in": "path",
            "name": "labelId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Label"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get get one label by id for the specified account",
        "tags": ["label"]
      },
      "put": {
        "operationId": "updateOne",
        "parameters": [
          {
            "explode": false,
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "explode": false,
            "in": "path",
            "name": "labelId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Label"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Label"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Update one label by id for the specified account",
        "tags": ["label"]
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "explode": false,
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        },
        "style": "simple"
      },
      "AccountId": {
        "explode": false,
        "in": "path",
        "name": "accountId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        },
        "style": "simple"
      },
      "LabelId": {
        "explode": false,
        "in": "path",
        "name": "labelId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        },
        "style": "simple"
      },
      "Page": {
        "explode": true,
        "in": "query",
        "name": "page",
        "required": false,
        "schema": {
          "default": 1,
          "type": "number"
        },
        "style": "form"
      },
      "PageSize": {
        "explode": true,
        "in": "query",
        "name": "pageSize",
        "required": false,
        "schema": {
          "default": 10,
          "type": "number"
        },
        "style": "form"
      },
      "Name": {
        "explode": true,
        "in": "query",
        "name": "name",
        "required": false,
        "schema": {
          "type": "string"
        },
        "style": "form"
      },
      "Month": {
        "explode": true,
        "in": "query",
        "name": "month",
        "required": false,
        "schema": {
          "maximum": 11,
          "minimum": 0,
          "type": "number"
        },
        "style": "form"
      },
      "Year": {
        "explode": true,
        "in": "query",
        "name": "year",
        "required": false,
        "schema": {
          "type": "number"
        },
        "style": "form"
      }
    },
    "schemas": {
      "CreationLabel": {
        "properties": {
          "name": {
            "example": "FOOD",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Label": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CreationLabel"
          },
          {
            "properties": {
              "id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "type": "object",
            "example": null
          }
        ],
        "type": "object",
        "example": null
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignUpResult": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignInResult": {
        "properties": {
          "account": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SignUpResult"
              }
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PaginationResult": {
        "properties": {
          "totalPage": {
            "minimum": 1,
            "type": "number"
          },
          "page": {
            "minimum": 1,
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
